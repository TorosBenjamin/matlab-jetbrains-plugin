<idea-plugin>
    <id>io.github.bendzsi.matlab</id>
    <name>Unofficial MATLAB Support</name>

    <vendor url="https://github.com/TorosBenjamin/matlab-jetbrains-plugin" email="toros.benjamin@tuta.io">bendzsi</vendor>

    <description><![CDATA[
    Unofficial MATLAB language support for JetBrains IDEs: editing, navigation, code analysis and running,
    without starting MATLAB for anything but running scripts.
    <ul>
      <li>Parser for modern MATLAB: classes, packages (<code>+pkg</code>), class folders (<code>@Cls</code>),
          <code>arguments</code> blocks, command syntax, <code>import</code></li>
      <li>Semantic highlighting, go to definition, find usages, rename (classes, files and constructors together),
          usage counts, structure view, breadcrumbs, folding of <code>%%</code> sections</li>
      <li>Completion that depends on the position: class members after <code>obj.</code>, struct fields,
          attributes, types, validators, package members; return types of methods such as singletons</li>
      <li>Inspections: unused variables, functions and imports, unreachable code; MATLAB's own code analyzer
          (mlint) when MATLAB is installed</li>
      <li>Run scripts or single <code>%%</code> sections with MATLAB or GNU Octave, from the gutter</li>
      <li>Live templates, Surround With, auto-inserted <code>end</code>, TODO and spell-checking</li>
    </ul>
    <p>Built on <a href="https://github.com/kornilova203/matlab-IntelliJ-plugin">Matlab Support</a> by Liudmila Kornilova.
    Uninstall that plugin before installing this one: both handle <code>.m</code> files. In CLion, <code>.m</code> files
    are Objective-C, so the two conflict there.</p>
    <p><i>Not affiliated with or endorsed by MathWorks. MATLAB is a registered trademark of The MathWorks, Inc.</i></p>
    ]]></description>

    <change-notes><![CDATA[
    <p>1.0.0: first release as a separate plugin, continuing <i>Matlab Support</i> 0.8.5.</p>
    <ul>
      <li>Parser: command syntax, arguments blocks, persistent, packages, imports, superclass calls, method signatures</li>
      <li>Highlighting of fields, methods, parameters, types, attributes, function calls; color settings page</li>
      <li>Type inference for objects, method results and singletons; struct field completion</li>
      <li>Packages and class folders, rename with files, usage counts, unused function and import inspections</li>
      <li>mlint integration, MATLAB executable setting with auto-detection, running single sections</li>
      <li>Navigation, structure view, breadcrumbs, live templates, Surround With, auto-inserted end</li>
      <li>Built for IntelliJ Platform 2025.2+</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Matlab" fieldName="INSTANCE" extensions="m" language="Matlab"
                  implementationClass="com.github.kornilova203.matlab.MatlabFileType"/>
        <lang.parserDefinition language="Matlab"
                               implementationClass="com.github.kornilova203.matlab.MatlabParserDefinition"/>
        <applicationConfigurable parentId="language" id="matlab.settings" displayName="MATLAB"
                                 instance="com.github.kornilova203.matlab.settings.MatlabSettingsConfigurable"/>
        <gotoClassContributor implementation="com.github.kornilova203.matlab.navigation.MatlabGotoClassContributor"/>
        <gotoSymbolContributor implementation="com.github.kornilova203.matlab.navigation.MatlabGotoSymbolContributor"/>
        <itemPresentationProvider forClass="com.github.kornilova203.matlab.psi.impl.MatlabFunctionDeclarationImpl"
                                  implementationClass="com.github.kornilova203.matlab.navigation.MatlabPresentationProvider"/>
        <itemPresentationProvider forClass="com.github.kornilova203.matlab.psi.impl.MatlabClassDeclarationImpl"
                                  implementationClass="com.github.kornilova203.matlab.navigation.MatlabPresentationProvider"/>
        <codeInsight.lineMarkerProvider language="Matlab" implementationClass="com.github.kornilova203.matlab.highlighting.MatlabSectionSeparatorProvider"/>
        <indexPatternBuilder implementation="com.github.kornilova203.matlab.MatlabIndexPatternBuilder"/>
        <spellchecker.support language="Matlab" implementationClass="com.github.kornilova203.matlab.MatlabSpellcheckingStrategy"/>
        <liveTemplateContext contextId="MATLAB" implementation="com.github.kornilova203.matlab.editor.templates.MatlabTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Matlab.xml"/>
        <lang.surroundDescriptor language="Matlab" implementationClass="com.github.kornilova203.matlab.editor.templates.MatlabSurroundDescriptor"/>
        <colorSettingsPage implementation="com.github.kornilova203.matlab.MatlabColorSettingsPage"/>
        <lang.syntaxHighlighterFactory language="Matlab"
                                       implementationClass="com.github.kornilova203.matlab.MatlabSyntaxHighlighterFactory"/>
        <configurationType implementation="com.github.kornilova203.matlab.execution.MatlabConfigurationType"/>
        <programRunner implementation="com.github.kornilova203.matlab.execution.MatlabProgramRunner"/>
        <runConfigurationProducer implementation="com.github.kornilova203.matlab.execution.MatlabSectionRunConfigurationProducer"/>
        <runLineMarkerContributor language="Matlab" implementationClass="com.github.kornilova203.matlab.execution.MatlabRunLineMarkerContributor"/>
        <runConfigurationProducer
                implementation="com.github.kornilova203.matlab.execution.MatlabRunConfigurationProducer"/>

        <lang.braceMatcher language="Matlab"
                           implementationClass="com.github.kornilova203.matlab.highlighting.MatlabPairedBraceMatcher"/>
        <lang.commenter language="Matlab"
                        implementationClass="com.github.kornilova203.matlab.editor.actions.MatlabCommentHandler"/>
        <quoteHandler fileType="Matlab" className="com.github.kornilova203.matlab.editor.actions.MatlabQuoteHandler"/>

        <completion.contributor language="Matlab" order="first"
                                implementationClass="com.github.kornilova203.matlab.completion.MatlabContextCompletionContributor"/>
        <completion.contributor language="Matlab"
                                implementationClass="com.github.kornilova203.matlab.completion.MatlabKeywordCompletionContributor"/>
        <completion.contributor language="Matlab"
                                implementationClass="com.github.kornilova203.matlab.completion.MatlabReferenceCompletionContributor"/>
        <completion.contributor language="Matlab"
                                implementationClass="com.github.kornilova203.matlab.completion.MatlabLibraryFunctionCompletionContributor"/>
        <lang.findUsagesProvider language="Matlab"
                                 implementationClass="com.github.kornilova203.matlab.MatlabFindUsagesProvider"/>
        <externalAnnotator language="Matlab" implementationClass="com.github.kornilova203.matlab.inspections.MatlabMlintAnnotator"/>
        <annotator language="Matlab" implementationClass="com.github.kornilova203.matlab.highlighting.MatlabAnnotator"/>
        <lang.elementManipulator forClass="com.github.kornilova203.matlab.psi.impl.MatlabRefExprImpl"
                                 implementationClass="com.github.kornilova203.matlab.psi.MatlabElementManipulator"/>
        <lang.refactoringSupport language="Matlab"
                                 implementationClass="com.github.kornilova203.matlab.refactoring.MatlabRefactoringSupportProvider"/>
        <lang.smartEnterProcessor language="Matlab"
                                  implementationClass="com.github.kornilova203.matlab.editor.smartEnter.MatlabSmartEnter"/>
        <lang.psiStructureViewFactory language="Matlab" implementationClass="com.github.kornilova203.matlab.structure.MatlabStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="com.github.kornilova203.matlab.structure.MatlabBreadcrumbsProvider"/>
        <lang.foldingBuilder language="Matlab" implementationClass="com.github.kornilova203.matlab.MatlabFoldingBuilder"/>
        <lineIndentProvider implementation="com.github.kornilova203.matlab.MatlabLineIndentProvider"/>
        <enterHandlerDelegate implementation="com.github.kornilova203.matlab.editor.actions.MatlabEnterInStringLiteralHandler"/>
        <lang.documentationProvider language="Matlab" implementationClass="com.github.kornilova203.matlab.MatlabDocumentationProvider"/>
        <elementDescriptionProvider implementation="com.github.kornilova203.matlab.MatlabElementDescriptionProvider"/>
        <psi.referenceContributor language="Matlab" implementation="com.github.kornilova203.matlab.psi.MatlabMethodSignatureReferenceContributor"/>
        <renamePsiElementProcessor implementation="com.github.kornilova203.matlab.refactoring.MatlabRenameProcessor"/>
        <inlineActionHandler implementation="com.github.kornilova203.matlab.refactoring.MatlabInlineVariableHandler"/>
        <typedHandler implementation="com.github.kornilova203.matlab.editor.actions.MatlabTypedHandler"/>
        <enterHandlerDelegate implementation="com.github.kornilova203.matlab.editor.actions.MatlabEnterHandler"/>
        <enterHandlerDelegate implementation="com.github.kornilova203.matlab.editor.actions.MatlabEndInserter"/>
        <codeInsight.typeInfo language="Matlab" implementationClass="com.github.kornilova203.matlab.MatlabTypeProvider"/>

        <stubElementTypeHolder class="com.github.kornilova203.matlab.psi.MatlabTypes"/>
        <stubIndex implementation="com.github.kornilova203.matlab.stub.MatlabFunctionDeclarationIndex"/>
        <stubIndex implementation="com.github.kornilova203.matlab.stub.MatlabClassDeclarationIndex"/>
        <stubIndex implementation="com.github.kornilova203.matlab.stub.MatlabGlobalVariableIndex"/>
        
        <localInspection language="Matlab" shortName="MatlabUnreachableCode" displayName="Unreachable code" groupName="Matlab" enabledByDefault="true" level="WARNING"
                         implementationClass="com.github.kornilova203.matlab.inspections.MatlabUnreachableCodeInspection"/>
        <localInspection language="Matlab" shortName="MatlabUnnecessaryContinue" displayName="Unnecessary 'continue' statement" groupName="Matlab" enabledByDefault="true" level="WARNING"
                         implementationClass="com.github.kornilova203.matlab.inspections.MatlabUnnecessaryContinueInspection"/>
        <localInspection language="Matlab" shortName="MatlabUnnecessaryReturn" displayName="Unnecessary 'return' statement" groupName="Matlab" enabledByDefault="true" level="WARNING"
                         implementationClass="com.github.kornilova203.matlab.inspections.MatlabUnnecessaryReturnInspection"/>
        <localInspection language="Matlab" shortName="MatlabUnusedImport" displayName="Unused import" groupName="Matlab" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.github.kornilova203.matlab.inspections.MatlabUnusedImportInspection"/>
        <localInspection language="Matlab" shortName="MatlabUnresolvedImport" displayName="Unresolved import" groupName="Matlab" enabledByDefault="true" level="WARNING"
                         implementationClass="com.github.kornilova203.matlab.inspections.MatlabUnresolvedImportInspection"/>
        <iconProvider implementation="com.github.kornilova203.matlab.MatlabFolderIconProvider" order="first"/>
        <localInspection language="Matlab" shortName="MatlabUnusedFunction" displayName="Unused function or private method" groupName="Matlab" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.github.kornilova203.matlab.inspections.MatlabUnusedFunctionInspection"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="com.github.kornilova203.matlab.codeVision.MatlabUsagesCodeVisionProvider"/>
        <localInspection language="Matlab" shortName="MatlabUnusedVariable" displayName="Unused variable and parameters" groupName="Matlab" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.github.kornilova203.matlab.inspections.MatlabUnusedVariableInspection"/>
        <highlightUsagesHandlerFactory implementation="com.github.kornilova203.matlab.highlighting.MatlabBlockKeywordHighlighterFactory"/>
        
    </extensions>
</idea-plugin>
